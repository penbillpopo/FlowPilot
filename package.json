{
  "name": "flowpilot",
  "version": "0.1.0",
  "private": true,
  "description": "每日開發任務代理",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "NODE_OPTIONS=--experimental-sqlite vitest run",
    "postinstall": "electron-rebuild -f -w node-pty",
    "dist": "electron-vite build && electron-builder --mac --dir"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.16",
    "marked": "^18.1.0",
    "node-pty": "^1.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ws": "^8.22.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.3"
  },
  "productName": "FlowPilot",
  "build": {
    "appId": "com.intellianalyze.flowpilot",
    "productName": "FlowPilot",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "resources/**",
      "package.json"
    ],
    "asarUnpack": [
      "resources/**",
      "node_modules/node-pty/**"
    ],
    "npmRebuild": true,
    "mac": {
      "target": "dir",
      "identity": "-",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": false
    }
  }
}
